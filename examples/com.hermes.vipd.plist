<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hermes.vipd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>mkdir -p /var/run/hermes-vip /var/log/hermes-vip &amp;&amp; chown _hermesvip:daemon /var/run/hermes-vip /var/log/hermes-vip &amp;&amp; exec sudo -u _hermesvip /usr/local/bin/hermes-vipd</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/hermes-vip/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/hermes-vip/stderr.log</string>
</dict>
</plist>
